using Gtk 4.0;

ColumnView {
  header-factory: BuilderListItemFactory {
    template ListHeader {}
  }

  row-factory: BuilderListItemFactory {
    template ColumnViewRow {}
  }

  ColumnViewColumn {
    factory: BuilderListItemFactory {
      template ColumnViewCell {
        child: Box {}
      }
    }
  }
}
